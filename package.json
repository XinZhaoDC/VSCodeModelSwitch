{
  "name": "vscodemodelswitch",
  "displayName": "AgentDeck",
  "description": "统一管理 Codex 与 Claude Code 的账号、API 供应商、独立网络和本地聊天历史。",
  "version": "0.10.0",
  "publisher": "xinzhaodc",
  "icon": "media/switch_889728.png",
  "license": "SEE LICENSE IN THIRD_PARTY_NOTICES.md",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/XinZhaoDC/AgentDeck.git"
  },
  "bugs": {
    "url": "https://github.com/XinZhaoDC/AgentDeck/issues"
  },
  "homepage": "https://github.com/XinZhaoDC/AgentDeck#readme",
  "keywords": [
    "vscode",
    "claude-code",
    "codex",
    "ai-cli",
    "provider-switcher",
    "model-switcher"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:vscodemodelswitch.providerView",
    "onCommand:vscodemodelswitch.openMenu",
    "onCommand:vscodemodelswitch.addProvider",
    "onCommand:vscodemodelswitch.switchProvider",
    "onCommand:vscodemodelswitch.openClaudeTerminal",
    "onCommand:vscodemodelswitch.openCodexTerminal",
    "onCommand:vscodemodelswitch.viewClaudeConfig",
    "onCommand:vscodemodelswitch.viewCodexConfig",
    "onCommand:vscodemodelswitch.exportPublicConfig",
    "onCommand:vscodemodelswitch.importPublicConfig"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscodemodelswitch",
          "title": "AgentDeck",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "vscodemodelswitch": [
        {
          "id": "vscodemodelswitch.providerView",
          "name": "客户端管理",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "vscodemodelswitch.openMenu",
        "title": "AgentDeck：打开管理菜单"
      },
      {
        "command": "vscodemodelswitch.addProvider",
        "title": "AgentDeck：添加供应商"
      },
      {
        "command": "vscodemodelswitch.switchProvider",
        "title": "AgentDeck：切换供应商"
      },
      {
        "command": "vscodemodelswitch.openClaudeTerminal",
        "title": "AgentDeck：打开 Claude 终端"
      },
      {
        "command": "vscodemodelswitch.openCodexTerminal",
        "title": "AgentDeck：打开 Codex 终端"
      },
      {
        "command": "vscodemodelswitch.viewClaudeConfig",
        "title": "AgentDeck：查看 Claude Code 配置"
      },
      {
        "command": "vscodemodelswitch.viewCodexConfig",
        "title": "AgentDeck：查看 Codex 配置"
      },
      {
        "command": "vscodemodelswitch.exportPublicConfig",
        "title": "AgentDeck：导出供应商配置"
      },
      {
        "command": "vscodemodelswitch.importPublicConfig",
        "title": "AgentDeck：导入供应商配置"
      },
      {
        "command": "vscodemodelswitch.speedTest",
        "title": "AgentDeck：运行生成测速"
      },
      {
        "command": "vscodemodelswitch.copySpeedQuery",
        "title": "AgentDeck：复制测速查询命令"
      }
    ],
    "configuration": {
      "title": "AgentDeck",
      "properties": {
        "vscodemodelswitch.globalCliSync": {
          "scope": "machine",
          "type": "boolean",
          "default": true,
          "description": "将当前供应商写入 Claude Code 和 Codex 的配置文件，默认启用。"
        },
        "vscodemodelswitch.configTarget": {
          "scope": "machine",
          "type": "string",
          "enum": [
            "sandbox",
            "real"
          ],
          "default": "real",
          "description": "选择配置写入位置：real 写入当前环境的真实用户目录；sandbox 写入隔离测试目录。"
        },
        "vscodemodelswitch.testHome": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "隔离测试模式下使用的用户目录，留空使用默认测试目录。"
        },
        "vscodemodelswitch.anthropicVersion": {
          "type": "string",
          "default": "2023-06-01",
          "description": "获取 Claude 兼容模型列表时使用的 Anthropic API 版本请求头。"
        },
        "vscodemodelswitch.codexExecutablePath": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "官方账号诊断和测速使用的 Codex 可执行文件绝对路径。留空时使用已安装 Codex 扩展的二进制文件或 PATH 中的命令。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "check": "tsc -p . --noEmit",
    "mock:models": "node scripts/mock-model-server.js",
    "package": "vsce package",
    "test:proxy": "npm run compile && node scripts/test-proxy.js",
    "test:codex-modes": "npm run compile && node scripts/test-codex-modes.js",
    "test:codex-proxy": "npm run compile && node scripts/test-codex-proxy.js",
    "test:speed": "npm run compile && node scripts/test-speed.js",
    "test:network": "npm run compile && node scripts/test-network.js",
    "test:sessions": "npm run compile && node scripts/test-sessions.js",
    "test:environments": "npm run compile && node scripts/test-environments.js",
    "test:recovery": "npm run compile && node scripts/test-recovery.js",
    "test:runtime": "npm run compile && node scripts/test-runtime-guard.js",
    "test:native-history": "npm run compile && node scripts/test-native-history.js",
    "test:operation-log": "npm run compile && node scripts/test-operation-log.js",
    "test:codex-ui": "npm run compile && node scripts/test-codex-ui.js",
    "test:isolated-network": "npm run compile && node scripts/test-isolated-network.js",
    "test:management": "npm run compile && node scripts/test-management.js",
    "test:fixed-home": "npm run compile && node scripts/test-fixed-home.js",
    "test:codex-workflows": "npm run compile && node scripts/test-codex-workflows.js",
    "test:provider-groups": "npm run compile && node scripts/test-provider-groups.js",
    "test:group-ui": "npm run compile && node scripts/test-group-ui.js",
    "test:group-import": "npm run compile && node scripts/test-group-import.js",
    "test:codex-network": "node scripts/test-codex-network.js",
    "test:codex-diagnostics": "node scripts/test-codex-diagnostics.js",
    "test:native-codex-network": "node scripts/test-native-codex-network.js",
    "test:codex-release": "python3 scripts/test-codex-release.py"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "dependencies": {
    "js-tiktoken": "1.0.21",
    "undici": "7.25.0"
  }
}
